# Deployed Intelligent Contract (required for writes and live reads)
NEXT_PUBLIC_RAINLINE_CONTRACT_ADDRESS=

# genlayer-js network name
NEXT_PUBLIC_GENLAYER_NETWORK=studio-next

# Optional. If unset, WalletConnect is hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional overrides (defaults match Studio Next)
# NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
